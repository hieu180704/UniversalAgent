{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./**/*.pem)",
      "Edit(./**/id_rsa*)",
      "Edit(./**/credentials.json)",
      "Edit(./**/secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Write(./**/*.pem)",
      "Write(./**/id_rsa*)",
      "Write(./**/credentials.json)",
      "Write(./**/secrets/**)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/safety-guard.js"
          }
        ]
      },
      {
        "matcher": "Read|NotebookRead|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/read-guard.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/closeout-trigger.js"
          }
        ]
      }
    ]
  }
}
